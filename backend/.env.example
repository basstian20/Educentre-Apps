# Copy to backend/.env and fill in. Never commit the real .env.
MONGO_URL=mongodb://localhost:27017
DB_NAME=edu_db
# Any long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me
# Optional: public resolvers used when the system DNS cannot resolve mongodb+srv:// (Atlas)
# DNS_NAMESERVERS=1.1.1.1,8.8.8.8
# Optional: demo admin created on first start
# ADMIN_EMAIL=admin@educentre.id
# ADMIN_PASSWORD=admin123

# Login brute-force protection (defaults shown)
# LOGIN_MAX_ATTEMPTS=5            # failures per ip+email before a lock
# LOGIN_MAX_ATTEMPTS_PER_EMAIL=20 # failures per email from any address before a lock
# LOGIN_LOCK_SECONDS=900          # lock duration (15 minutes)
# TRUST_PROXY=true                # read the client IP from X-Forwarded-For (set behind a reverse proxy)

# Password reset / outgoing email
# MAIL_PROVIDER=console             # console (log only, for dev/demo) or smtp
# MAIL_FROM=EduCentre <no-reply@your-domain.id>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# FRONTEND_URL=https://educentre-apps.vercel.app   # base of the emailed reset link
# PASSWORD_RESET_MINUTES=30
# PASSWORD_RESET_MAX_PER_HOUR=3
# PASSWORD_RESET_DEBUG_LINK=false   # dev/demo only: return the link in the API response (console mailer only)
